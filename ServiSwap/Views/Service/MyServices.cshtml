@model List<Service>

@{
	ViewData["Title"] = "Mes services";
	string? successMessage = TempData["SuccessMessage"] as string;
	string? errorMessage = TempData["ErrorMessage"] as string;
}

<section id="works" class="works">
	<div class="container">
		<div class="works-content">
			@if (!string.IsNullOrWhiteSpace(successMessage))
			{
				<div class="alert alert-success" role="status">@successMessage</div>
			}
			@if (!string.IsNullOrWhiteSpace(errorMessage))
			{
				<div class="alert alert-danger" role="alert">@errorMessage</div>
			}
			<div class="row">
				<p><a class="add-service-link" asp-controller="Service" asp-action="AddS">Ajouter un service</a></p>
				@if (Model.Count > 0)
				{
					@foreach (Service s in Model)
					{
						<div class="col-md-4 col-sm-6">
							<div class="single-how-works">
								<h2>
									<strong>
										<a 
											asp-controller="Service" 
											asp-action="ServiceDetails" 
											asp-route-serviceId="@s.ServiceId" 
											class="sTitle"
										>
											@s.ServiceName
										</a>
									</strong>
								</h2>
								<p><strong>Date de publication:</strong> @s.DateOfPublication.ToString("dd/MM/yyyy")</p>
								<p><strong>Lieu:</strong> @s.Provider.City</p>
								<p class="service-description">@s.ServiceDescription</p>
							</div>
						</div>
					}
				}
				else
				{
					<h4 class="no-service-message">Vous ne proposez actuellement aucun service.</h4>
				}
			</div>
		</div>
	</div>
</section>