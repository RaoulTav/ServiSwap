@model List<RequestedService>

@{
    ViewData["Title"] = "Services donnés";
    string? successMessage = TempData["SuccessMessage"] as string;
    string? errorMessage = TempData["ErrorMessage"] as string;
}

<section id="works" class="works">
	<div class="container">
		<div class="works-content">
			@if (!string.IsNullOrWhiteSpace(successMessage))
			{
				<div class="alert alert-success" role="status">@successMessage</div>
			}
			@if (!string.IsNullOrWhiteSpace(errorMessage))
			{
				<div class="alert alert-danger" role="alert">@errorMessage</div>
			}
			<div class="row">
				@if (Model.Count > 0)
				{
					@foreach (RequestedService provS in Model)
					{
						<div class="col-md-4 col-sm-6 rpservice @(provS.State.Equals(RequestedServiceState.Completed) ? "disabled" : "")">
							<div class="single-how-works rpservice @(provS.State.Equals(RequestedServiceState.Completed) ? "disabled" : "")">
								<h2>
									<a 
										asp-controller="Service" 
										asp-action="ServiceDetails" 
										asp-route-serviceId="@provS.Service.ServiceId" 
										class="sTitle"
									>
										@provS.Service.ServiceName
									</a>
								</h2>
								<p><strong>Demandeur: </strong>@provS.Requester.Username</p>
								<p><strong>Date de la demande:</strong> @provS.DateOfRequest</p>
								<p><strong>Lieu:</strong> @provS.Provider.City</p>
								<p style="white-space: pre-wrap;"><strong>Email du demandeur: </strong>@provS.Requester.Email</p>
								@if (provS.State.Equals(RequestedServiceState.Pending))
								{
									<form class="custom-form" asp-controller="Service" asp-action="ReportHours" method="post">
										<input type="hidden" name="reqServiceId" value="@provS.RequestedServiceId" />
										<label class="custom-label" for="reportedHours-@provS.RequestedServiceId">Heures prestées</label>
										<input 
											id="reportedHours-@provS.RequestedServiceId" 
											name="reportedHours" 
											type="number" 
											min="0" 
											value="@provS.ReportedHours" 
											required 
										/>
										<input class="submit-button" type="submit" value="Envoyer" />
									</form>
								}
								else
								{
									<p class="requestservice">Le demandeur n'a pas encore confirmé le nombre d'heures que vous avez encodé</p>
								}
							</div>
						</div>
					}
				} else
				{
					<h4 class="no-service-message">Vous ne fournissez actuellement aucun service.</h4>
				}
			</div>
		</div>
	</div>
</section>