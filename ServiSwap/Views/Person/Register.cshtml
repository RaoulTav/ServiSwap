@model ServiSwap.ViewModels.PersonCreationViewModel

@{
    ViewData["Title"] = "Créer un compte";
}

<div class="register-form-container">
    <form asp-controller="Person" asp-action="Register" method="post">
        <label asp-for="Username"></label>
        <input asp-for="Username" /><br />
        <span asp-validation-for="Username" class="field-validation-error"></span>

        <label asp-for="LastName"></label>
        <input asp-for="LastName" /><br />
        <span asp-validation-for="LastName" class="field-validation-error"></span>

        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" /><br />
        <span asp-validation-for="FirstName" class="field-validation-error"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" /><br />
        <span asp-validation-for="Password" class="field-validation-error"></span>

        <input asp-for="Password2" /><br />
        <span asp-validation-for="Password2" class="field-validation-error"></span>

        <label asp-for="Email"></label>
        <input asp-for="Email" /><br />
        <span asp-validation-for="Email" class="field-validation-error"></span>

        <label asp-for="StreetName"></label>
        <input asp-for="StreetName" /><br />
        <span asp-validation-for="StreetName" class="field-validation-error"></span>

        <label asp-for="StreetNumber"></label>
        <input asp-for="StreetNumber" /><br />
        <span asp-validation-for="StreetNumber" class="field-validation-error"></span>

        <label asp-for="City"></label>
        <input asp-for="City" /><br />
        <span asp-validation-for="City" class="field-validation-error"></span>

        <input type="submit" value="Créer un compte" />
    </form>
    @if (ViewBag.Error != null)
    {
        <div class="field-validation-error">
            @ViewBag.Error
        </div>
    }
</div>