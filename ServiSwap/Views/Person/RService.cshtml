@model List<RequestedService>

@{
    ViewData["Title"] = "Services demandés";
    string? successMessage = TempData["SuccessMessage"] as string;
    string? errorMessage = TempData["ErrorMessage"] as string;
}

<section id="works" class="works">
	<div class="container">
		<div class="works-content">
			@if (!string.IsNullOrWhiteSpace(successMessage))
			{
				<div class="alert alert-success" role="status">@successMessage</div>
			}
			@if (!string.IsNullOrWhiteSpace(errorMessage))
			{
				<div class="alert alert-danger" role="alert">@errorMessage</div>
			}
			<div class="row">
				@if (Model.Count > 0)
				{
					@foreach (RequestedService reqS in Model)
					{
						<div class="col-md-4 col-sm-6 rpservice @(reqS.State.Equals(RequestedServiceState.Pending) ? "disabled" : "")">
							<div class="single-how-works rpservice @(reqS.State.Equals(RequestedServiceState.Pending) ? "disabled" : "")">
								<h2>
									<a 
										asp-controller="Service" 
										asp-action="ServiceDetails" 
										asp-route-serviceId="@reqS.Service.ServiceId" 
										class="sTitle"
									>
										@reqS.Service.ServiceName
									</a>
								</h2>
								<p><strong>Fournisseur: </strong>@reqS.Service.Provider.Username</p>
								<p><strong>Date de la demande:</strong> @reqS.DateOfRequest</p>
								<p><strong>Lieu:</strong> @reqS.Provider.City</p>
								<p style ="white-space: pre-wrap;"><strong>Email du fournisseur: </strong>@reqS.Provider.Email</p>
								@if (reqS.State.Equals(RequestedServiceState.Completed))
								{
									<form class="custom-form" asp-controller="Service" asp-action="ConfirmHours" method="post">
										<input class="hidden-input" type="hidden" name="reqServiceId" value="@reqS.RequestedServiceId" />
										<label class="custom-label" asp-for="@reqS.ReportedHours"></label>
										<input class="readonly-input" asp-for="@reqS.ReportedHours" readonly />
										<input class="submit-button" type="submit" value="Confirmer" />
									</form>
								}
								else
								{
									<p class="requestservice">Le fournisseur du service n'a pas encore donné le nombre d'heure de la prestation.</p>
								}
							</div>
						</div>
					}
				}
				else
				{
					<h4 class="no-service-message">Vous n'avez pour l'instant fait aucune demande de service.</h4>
				}
			</div>
		</div>
	</div>
</section>